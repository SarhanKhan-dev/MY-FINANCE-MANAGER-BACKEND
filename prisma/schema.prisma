generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum Currency {
  PKR
  USD
}

enum WalletKind {
  CASH
  BANK
  MOBILE
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  email        String?    @unique
  passwordHash String?
  pinHash      String?
  pinAttempts  Int        @default(0)
  name         String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  onboardedAt  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  settings          UserSettings?
  wallets           Wallet[]
  categories        Category[]
  merchants         Merchant[]
  people            Person[]
  transactions      Transaction[]
  transactionItems  TransactionItem[]
  products          Product[]
  productCategories ProductCategory[]
  bills             Bill[]
  subscriptions     Subscription[]
  investments       Investment[]
  investmentSnaps   InvestmentSnapshot[]
  goldHoldings      GoldHolding[]
  alertLogs         AlertLog[]
  events            EventLog[]
  passwordTokens    PasswordToken[]
}

enum PasswordTokenPurpose {
  INVITE
  RESET
}

model PasswordToken {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String               @unique
  purpose   PasswordTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId])
}

model UserSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetCapPkr        Decimal  @default(100000) @db.Decimal(14, 2)
  budgetCycleStartDay Int      @default(1)
  countLendingInCap   Boolean  @default(false)
  countWriteOffsInCap Boolean  @default(true)
  goldRatePkrPerGram  Decimal? @db.Decimal(14, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Wallet {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  kind       WalletKind
  currency   Currency
  archivedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  outgoing Transaction[] @relation("fromWallet")
  incoming Transaction[] @relation("toWallet")

  @@index([userId])
}

model Category {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

model Merchant {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

model Person {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  note       String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  CONVERSION
  BORROW
  LEND
  REPAY_IN
  REPAY_OUT
  WORK_OFFSET
  TAKEN
  WRITE_OFF
  BALANCE_OUT
  INVESTMENT_IN
  INVESTMENT_OUT
}

model Transaction {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           TransactionType
  date           DateTime
  amount         Decimal         @db.Decimal(14, 2)
  currency       Currency
  fxRate         Decimal?        @db.Decimal(12, 6)
  toAmount       Decimal?        @db.Decimal(14, 2)
  fromWalletId   String?
  fromWallet     Wallet?         @relation("fromWallet", fields: [fromWalletId], references: [id], onDelete: Restrict)
  toWalletId     String?
  toWallet       Wallet?         @relation("toWallet", fields: [toWalletId], references: [id], onDelete: Restrict)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  merchantId     String?
  merchant       Merchant?       @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  personId       String?
  person         Person?         @relation(fields: [personId], references: [id], onDelete: SetNull)
  incomeSource   String?
  incomeType     String?
  note           String?
  billId         String?
  bill           Bill?           @relation(fields: [billId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  investmentId   String?
  investment     Investment?     @relation(fields: [investmentId], references: [id], onDelete: SetNull)
  idempotencyKey String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items TransactionItem[]

  @@unique([userId, idempotencyKey])
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([fromWalletId])
  @@index([toWalletId])
}

enum InvestmentKind {
  STOCK
  ACCOUNT
  OTHER
}

model Investment {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  kind             InvestmentKind
  currency         Currency       @default(PKR)
  units            Decimal?       @db.Decimal(16, 4)
  currentUnitPrice Decimal?       @db.Decimal(14, 4)
  costBasis        Decimal        @default(0) @db.Decimal(14, 2)
  currentValue     Decimal        @default(0) @db.Decimal(14, 2)
  realizedPnl      Decimal        @default(0) @db.Decimal(14, 2)
  zakatable        Boolean        @default(false)
  archivedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  snapshots    InvestmentSnapshot[]
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

model InvestmentSnapshot {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  date         DateTime
  value        Decimal    @db.Decimal(14, 2)

  @@unique([investmentId, date])
  @@index([userId])
}

model GoldHolding {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  weightGrams   Decimal   @db.Decimal(10, 3)
  purity        String?
  boughtPricePkr Decimal  @db.Decimal(14, 2)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

enum RepeatRule {
  MONTHLY
  WEEKLY
  ONCE
}

model Bill {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  amount          Decimal?   @db.Decimal(14, 2)
  currency        Currency   @default(PKR)
  repeat          RepeatRule @default(MONTHLY)
  nextDueOn       DateTime
  reminderDays    Int        @default(2)
  defaultWalletId String?
  categoryId      String?
  lastPaidOn      DateTime?
  archivedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  transactions Transaction[]

  @@index([userId])
}

enum SubscriptionPeriod {
  MONTHLY
  YEARLY
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  amount          Decimal            @db.Decimal(14, 2)
  currency        Currency           @default(PKR)
  period          SubscriptionPeriod @default(MONTHLY)
  renewsOn        DateTime
  defaultWalletId String?
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  transactions Transaction[]

  @@index([userId])
}

model ProductCategory {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  products Product[]

  @@unique([userId, name])
  @@index([userId])
}

model Product {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  unit              String           @default("piece")
  productCategoryId String?
  productCategory   ProductCategory? @relation(fields: [productCategoryId], references: [id], onDelete: SetNull)
  archivedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  items TransactionItem[]

  @@unique([userId, name])
  @@index([userId])
}

model TransactionItem {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id], onDelete: Restrict)
  label         String?
  quantity      Decimal     @db.Decimal(10, 3)
  unitPrice     Decimal     @db.Decimal(14, 2)
  lineTotal     Decimal     @db.Decimal(14, 2)

  @@index([userId, productId])
  @@index([transactionId])
}

model AlertLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleKey  String
  threshold Int
  createdAt DateTime @default(now())

  @@unique([userId, cycleKey, threshold])
}

model EventLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model AdminAuditLog {
  id             String   @id @default(cuid())
  actorId        String
  actorUsername  String
  action         String
  targetId       String?
  targetUsername String
  createdAt      DateTime @default(now())

  @@index([createdAt])
}
