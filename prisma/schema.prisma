generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum Currency {
  PKR
  USD
}

enum WalletKind {
  CASH
  BANK
  MOBILE
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  email        String?    @unique
  passwordHash String?
  pinHash      String?
  pinAttempts  Int        @default(0)
  name         String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  onboardedAt  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  settings       UserSettings?
  wallets        Wallet[]
  categories     Category[]
  events         EventLog[]
  passwordTokens PasswordToken[]
}

enum PasswordTokenPurpose {
  INVITE
  RESET
}

model PasswordToken {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String               @unique
  purpose   PasswordTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId])
}

model UserSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetCapPkr        Decimal  @default(100000) @db.Decimal(14, 2)
  budgetCycleStartDay Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Wallet {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  kind       WalletKind
  currency   Currency
  archivedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
}

model Category {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model EventLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model AdminAuditLog {
  id             String   @id @default(cuid())
  actorId        String
  actorUsername  String
  action         String
  targetId       String?
  targetUsername String
  createdAt      DateTime @default(now())

  @@index([createdAt])
}
