# Neon Postgres — pooled (pgbouncer) connection, used by the app at runtime
DATABASE_URL=

# Neon Postgres — direct (unpooled) connection, used only by prisma migrate
DIRECT_URL=

# Long random string used to sign JWT access tokens
JWT_SECRET=

# Access token lifetime (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# Secret that Vercel Cron requests must send in the x-cron-secret header
CRON_SECRET=

# Resend API key for notification emails
RESEND_API_KEY=

# Comma-separated allowed frontend origins for CORS.
# A leading * matches any subdomain, e.g. https://*.vercel.app
FRONTEND_ORIGINS=http://localhost:3000

# The frontend's canonical URL, used to build set-password links
FRONTEND_APP_URL=http://localhost:3000

# Superadmin account created by `npm run seed` (first deploy only)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=
